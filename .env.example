APP_NAME=FastAPI NoSQL Market Monitor
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

POLL_INTERVAL_SECONDS=20
REDIS_TTL_SECONDS=45
MONITOR_ENABLED=true

MARKET_API_URL=https://economia.awesomeapi.com.br/last/USD-BRL,EUR-BRL
SYMBOLS=USD-BRL,EUR-BRL
REQUEST_TIMEOUT_SECONDS=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=password
MONGO_DATABASE=market_intelligence
MONGO_COLLECTION=raw_quotes

CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=market_intelligence
CASSANDRA_TABLE=historico_precos

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

FAKER_LOCALE=pt_BR
SEED_INVESTOR_COUNT=6
